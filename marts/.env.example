# Dedicated Marts database. If unavailable, the backend falls back to DATABASE_URL.
MARTS_DATABASE_URL=
DATABASE_URL=

# Required for signing Marts sessions.
MARTS_JWT_SECRET=

# Optional Marts-scoped service keys.
MARTS_OPENAI_API_KEY=
MARTS_GITHUB_API_KEY=
MARTS_GROQ_API_KEY=
MARTS_NVIDIA_API_KEY=
MARTS_GROK_API_KEY=
MARTS_GEMINI_API_KEY=
MARTS_DEEPSEEK_API_KEY=
MARTS_OPENROUTER_API_KEY=
MARTS_REDIS_URL=redis://localhost:6379/0

# Optional broker and market-data settings.
MARTS_ALPACA_API_KEY=
MARTS_ALPACA_SECRET_KEY=
MARTS_NEWSAPI_KEY=
MARTS_ALPHA_VANTAGE_KEY=
MARTS_FRED_API_KEY=
MARTS_COINGECKO_API_KEY=
MARTS_TATUM_API_KEY=
MARTS_TATUM_WEBHOOK_SECRET=
MARTS_MASTER_SEED=
MARTS_PROMETHEUS_URL=http://localhost:9090
MARTS_GRAFANA_URL=http://localhost:3001
MARTS_REDIS_RESULT_BACKEND=redis://localhost:6379/1

# Optional Marts-scoped S3-compatible file storage. Local uploads are used when
# these values are not configured.
MARTS_FILE_ACCESS_KEY_ID=
MARTS_FILE_SECRET_ACCESS_KEY=
MARTS_FILE_ENDPOINT_URL=
MARTS_FILE_BUCKET=
MARTS_FILE_REGION=
MARTS_STORAGE_FOLDER=marts

# Public URL/origin configuration.
MARTS_APP_URL=
MARTS_CORS_ALLOW_ORIGINS=
MARTS_DEV_BACKEND_URL=http://127.0.0.1:8090
MARTS_WEBHOOK_URL=
MARTS_ADMIN_EMAIL=
MARTS_ADMIN_PASSWORD=

# Optional Marts-scoped notifications and messaging.
MARTS_SMTP_HOST=
MARTS_SMTP_PORT=587
MARTS_SMTP_USER=
MARTS_SMTP_PASSWORD=
MARTS_RESEND_API_KEY=
MARTS_RESEND_FROM_EMAIL=
MARTS_TELEGRAM_BOT_TOKEN=
MARTS_TELEGRAM_CHAT_ID=
MARTS_TELEGRAM_ADMIN_CHAT_ID=
MARTS_TELEGRAM_WEBHOOK_SECRET=
MARTS_TWILIO_ACCOUNT_SID=
MARTS_TWILIO_AUTH_TOKEN=
MARTS_TWILIO_WHATSAPP_NUMBER=
MARTS_WHATSAPP_TO_NUMBER=
MARTS_EVOLUTION_API_URL=
MARTS_EVOLUTION_API_KEY=
MARTS_EVOLUTION_INSTANCE=
MARTS_SLACK_BOT_TOKEN=
MARTS_SLACK_CHANNEL=#trading-alerts
MARTS_EMAIL_TO=