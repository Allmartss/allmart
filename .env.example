# ─────────────────────────────────────────────────────────────────────────────
# AllMart — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Required fields are marked [REQUIRED].
# Optional fields are marked [OPTIONAL] — the feature is disabled if omitted.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string.
# Use one of:
#   Supabase:  postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
#   Local:     postgres://allmart:password@localhost:5432/allmart
DATABASE_URL=

# [OPTIONAL] Alias for DATABASE_URL — if both are set, SUPABASE_DB_URL takes priority.
SUPABASE_DB_URL=


# ── Security ─────────────────────────────────────────────────────────────────

# [REQUIRED] Random string used to sign session cookies. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# ── Server ───────────────────────────────────────────────────────────────────

# [OPTIONAL] Port the API server listens on. Default: 8080
PORT_API=8080

# [OPTIONAL] Set to "production" in live deployments.
NODE_ENV=production

# [OPTIONAL] Full public URL of your site (used in email links, webhooks, etc.)
# Example: https://yourdomain.com
APP_URL=

# [OPTIONAL] Default admin account email (set before first seed).
ADMIN_EMAIL=admin@yourdomain.com

# [OPTIONAL] Log level: error | warn | info | debug. Default: info
LOG_LEVEL=info


# ── File Storage (S3-compatible) ──────────────────────────────────────────────
# [OPTIONAL] If not set, uploaded files are stored in the local ./uploads/ folder.
# Works with Supabase Storage, Cloudflare R2, AWS S3, Backblaze B2, etc.

FILE_ENDPOINT_URL=
FILE_BUCKET=
FILE_ACCESS_KEY_ID=
FILE_SECRET_ACCESS_KEY=
FILE_REGION=auto


# ── Stripe Payments ───────────────────────────────────────────────────────────
# [OPTIONAL] Without these, the checkout flow will be disabled.

# Use sk_test_... for testing, sk_live_... for production.
STRIPE_SECRET_KEY=

# From Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=


# ── Telegram Bot ──────────────────────────────────────────────────────────────
# [OPTIONAL] Without these, Telegram order notifications will be disabled.

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your personal or group chat ID (e.g. -100123456789)
TELEGRAM_CHAT_ID=

# Any random string — used to verify webhook requests are from Telegram
TELEGRAM_WEBHOOK_SECRET=

# [OPTIONAL] Your bot's @username (e.g. MyShopBot) — used in command matching
TELEGRAM_BOT_NAME=


# ── Email ────────────────────────────────────────────────────────────────────
# [OPTIONAL] Use SMTP (primary) or Brevo API (fallback). SMTP is tried first;
# if it fails or isn't configured, Brevo is used automatically.

# Option A: SMTP (works with Gmail, SendGrid, Mailgun, Brevo SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Option B: Brevo transactional API (https://brevo.com)
# BREVO_API_KEY is already listed above under "Brevo (Sendinblue)"

# [REQUIRED for Brevo] The FROM address used when sending via Brevo.
# This MUST be a verified sender in your Brevo account:
#   Brevo Dashboard → Settings → Senders & IPs → Senders → Add a sender
# If you own a domain, verify it under "Domains" for best deliverability (DKIM/SPF).
# Without this, the server falls back to SMTP_USER as the sender, which is NOT
# authorized by Brevo and will cause emails to bounce or go to spam.
BREVO_SENDER_EMAIL=


# ── AI Features ───────────────────────────────────────────────────────────────
# [OPTIONAL] Without these, AI search and recommendations are disabled.

# Groq (fast, free tier available — https://console.groq.com)
GROQ_API_KEY=

# NVIDIA NIM (alternative AI backend)
NVIDIA_API_KEY=

# [OPTIONAL] Custom OpenAI-compatible base URL (e.g. for local Ollama or proxies)
AI_INTEGRATIONS_OPENAI_BASE_URL=
